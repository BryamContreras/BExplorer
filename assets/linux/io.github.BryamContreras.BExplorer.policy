<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>BExplorer</vendor>
  <icon_name>bexplorer</icon_name>

  <action id="io.github.BryamContreras.BExplorer.elevated-helper">
    <description>Authorize BExplorer to access protected files and folders</description>
    <description xml:lang="es">Autorizar a BExplorer a acceder a archivos y carpetas protegidos</description>
    <message>Authentication is required for BExplorer to access protected files or folders.</message>
    <message xml:lang="es">Se requiere autenticación para que BExplorer acceda a archivos o carpetas protegidos.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bexplorer</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
